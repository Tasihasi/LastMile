# LastMile backend environment template.
#
# Copy this file to `backend/.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed — it holds secrets.
# Only this `.env.example` (placeholders only) belongs in version control.

# --- Core Django ---

# Debug mode. Keep "True" for local dev. MUST be "False" in production.
DEBUG=True

# Django cryptographic secret key. REQUIRED when DEBUG=False.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Do not reuse the insecure dev fallback in production.
SECRET_KEY=replace-with-a-50-plus-character-random-string

# Comma-separated hostnames Django will serve (no scheme, no trailing slash).
# Example: ALLOWED_HOSTS=lastmile.example.com,www.lastmile.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Set automatically by Render; leave blank for local dev.
RENDER_EXTERNAL_HOSTNAME=

# Comma-separated frontend origins allowed to call the API (include scheme).
# Example: CORS_ALLOWED_ORIGINS=https://lastmile.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- External services ---

# OpenRouteService API key (https://openrouteservice.org/dev/#/signup).
# REQUIRED for geocoding/optimization. This is a secret — keep it out of git.
ORS_API_KEY=your_openrouteservice_api_key_here

# --- Testing ---

# When "true", mocks Nominatim/ORS with deterministic data for E2E tests.
# Leave blank/unset outside of test runs.
E2E_MOCK=
