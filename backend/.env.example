ORS_API_KEY=your_openrouteservice_api_key_here

# Database connection (12-factor). Leave UNSET for local development: with
# DEBUG=True the app falls back to SQLite (backend/db.sqlite3), so local work
# never touches the production database.
# In production (DEBUG=False, e.g. Render) DATABASE_URL is REQUIRED and must point
# at PostgreSQL — use the pooled Neon connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
