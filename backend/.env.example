ORS_API_KEY=your_openrouteservice_api_key_here

# Address pipeline (all optional, see docs/self-hosted-nominatim.md)
# GEOCODE_CONCURRENCY=5                      # requests in flight per batch
# NOMINATIM_URL=http://localhost:8080/search # self-hosted Nominatim (Hungary): no 1 request/s limit
# GOOGLE_GEOCODING_API_KEY=                  # last-resort stage; off when empty
# ADDRESS_STREETS_FILE=                      # street list built with manage.py build_street_index

# Database connection (12-factor). Leave UNSET for local development: with
# DEBUG=True the app falls back to SQLite (backend/db.sqlite3), so local work
# never touches the production database.
# In production (DEBUG=False, e.g. Render) DATABASE_URL is REQUIRED and must point
# at PostgreSQL — use the pooled Neon connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
